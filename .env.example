# 复制为 .env 后填写：cp .env.example .env

# ============ 必填 ============
# DashScope（阿里云百炼）API Key，用于 text-embedding-v4 与 Qwen
# 申请：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxx

# ============ 元数据后端 ============
# auto   优先连 Redis，不可用时自动回退 SQLite（默认）
# redis  强制 Redis，连不上直接报错
# sqlite 强制 SQLite，零外部依赖
METADATA_BACKEND=auto
METADATA_PREFIX=basiclaw

# Redis 连接（METADATA_BACKEND=sqlite 时无需配置）
# REDIS_URL=redis://:password@127.0.0.1:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# SQLite 数据库位置（默认 <DATA_DIR>/metadata.sqlite3）
# SQLITE_PATH=/path/to/metadata.sqlite3

# ============ 路径 ============
# 向量索引与中间产物目录（默认 <项目根>/data）
# VECTOR_DATA_DIR=/path/to/faiss_data
# UPLOAD_DIR=/path/to/uploads

# ============ 模型 ============
# EMBEDDING_MODEL=text-embedding-v4
# LLM_MODEL=qwen-turbo
# LLM_ENABLED=true

# ============ OCR ============
# 仅扫描版 PDF 需要。需先安装 tesseract 二进制：
#   macOS: brew install tesseract tesseract-lang
#   Debian: apt-get install tesseract-ocr tesseract-ocr-chi-sim
# OCR_ENABLED=false
# OCR_LANG=chi_sim+eng

# ============ Gradio ============
# 容器部署需设为 0.0.0.0，本地开发保持 127.0.0.1
# GRADIO_SERVER_NAME=127.0.0.1
# GRADIO_SERVER_PORT=7860

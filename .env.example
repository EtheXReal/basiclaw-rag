# DashScope API Key，用于调用达摩盘 text-embedding-v4 / Qwen 模型
DASHSCOPE_API_KEY=your_dashscope_key_here

# 可选：向量/索引存储目录，推荐纯 ASCII 路径（Windows 示例）
# VECTOR_DATA_DIR=C:\faiss_data

# 可选：上传目录（默认使用 data/uploads）
# UPLOAD_DIR=C:\basiclaw_uploads

# 可选：Redis 连接配置（默认 localhost:6379 无密码）
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# 也可使用完整 URL 写法
# REDIS_URL=redis://:password@127.0.0.1:6379/0

# LLM 设置（可选）
# LLM_MODEL=qwen-turbo
# LLM_ENABLED=true

# OCR 设置（可选）
# OCR_ENABLED=true
# OCR_LANG=chi_sim+eng
